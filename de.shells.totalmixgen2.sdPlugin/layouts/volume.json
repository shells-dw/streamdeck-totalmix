{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "layouts/volume.json",
  "items": [
    {
      "key": "bg",
      "type": "pixmap",
      "rect": [0, 0, 200, 100],
      "zOrder": 0,
      "value": "imgs/clearWash.png"
    },
    {
      "key": "name",
      "type": "text",
      "rect": [8, 6, 184, 20],
      "zOrder": 10,
      "font": { "size": 15, "weight": 600 },
      "alignment": "center"
    },
    {
      "key": "value",
      "type": "text",
      "rect": [8, 28, 184, 26],
      "zOrder": 10,
      "font": { "size": 22, "weight": 600 },
      "alignment": "center"
    },
    {
      "key": "muteIndicator",
      "type": "pixmap",
      "rect": [16, 31, 22, 22],
      "zOrder": 20,
      "value": "imgs/clearMuteBadge.png"
    },
    {
      "key": "indicator",
      "type": "bar",
      "rect": [16, 60, 168, 12],
      "zOrder": 10,
      "value": 0,
      "subtype": 4,
      "border_w": 0,
      "bar_bg_c": "0:#1b1b1b,1:#1b1b1b",
      "bar_fill_c": "#2ea3f2"
    }
  ]
}
