  "source": "OSCProtocoll_260721.ods — OSC-Commands TotalMix FX 2.1 beta 2 \"Global OSC\", 2026-07-21",
  "notes": {
    "channelNumbering": "Channel numbers ('channel', 'input', 'playback', 'output') count starting at 0",
    "presetNumbering": "Preset, snapshot etc. ('numbers') count starting at 1",
    "stereoLR": "In stereo channels, L/R-flagged params address the right channel by channel number + 1; all other parameters are addressed by the left number",
    "triggerValues": "(f)-typed commands need no value, but a value below 0.5 is ignored",
    "statusRate": "Status is sent approx. 1 param per second",
    "red": "Entries marked red in the table are not implemented yet; carried here as implemented: false"
  },
